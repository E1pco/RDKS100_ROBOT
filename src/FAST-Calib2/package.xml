<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fast_calib</name>
  <version>0.0.0</version>

  <description>
    FAST-Calib2: LiDAR-camera extrinsic calibration for large-spot LiDARs
  </description>

  <maintainer email="zhengcr@connect.hku.hk">claydergc</maintainer>

  <license>GPL-2.0</license>

  <author email="zhengcr@connect.hku.hk">Chunran Zheng</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>rosbag2_cpp</depend>
  <depend>livox_ros_driver2</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
